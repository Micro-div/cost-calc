# Server-only API key for the optional AI step in /api/analyze (Groq).
# Get one at https://console.groq.com/keys
# NEVER prefix this with NEXT_PUBLIC_ and never call Groq from client code.
GROQ_API_KEY=

# Optional: override the Groq chat model (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant
